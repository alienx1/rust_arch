# --- Rust build output (can be tens of GB: set CARGO_TARGET_DIR outside the repo) -------------
/target/
**/target/

# --- Web build output (trunk) ----------------------------------------------------------------
**/dist/
**/dist-e2e/
**/node_modules/

# --- Local configuration and secrets ----------------------------------------------------------
# .env holds this machine's credentials; copy .env.example to .env (see README.md).
.env
.env.*
!.env.example

# kubeconfig written by `make bootstrap` / k3d (contains cluster credentials)
/.kube/

# --- Nix (flake.nix): build results and direnv state -------------------------------------------
/result
/result-*
.direnv/

# --- Rust tooling leftovers ------------------------------------------------------------------
**/*.rs.bk
perf.data*
flamegraph.svg
*.profraw

# --- Test / debug artifacts --------------------------------------------------------------------
# e.g. downloaded CSV exports, screenshots and heap snapshots made while debugging
/tmp/
/scratch/
*.heapsnapshot
*.orig
*.rej

# --- AI assistant local state (AGENTS.md is tracked; per-user settings are not) ----------------
.claude/settings.local.json
.claude/projects/

# --- Logs, scratch, editor and OS noise ------------------------------------------------------
*.log
*.pid
*.tmp
*.swp
*~
.DS_Store
Thumbs.db
.idea/
# .vscode/ is kept: it only holds the Nix environment selector settings

# Trunk dev-server config: generated by `make web` from Trunk.toml.tmpl + .env (the template is tracked)
handler/web/application/master/Trunk.toml

# Local-only Trunk configs used for end-to-end tests
Trunk.e2e.toml

# --- Deliberately tracked (do not ignore) -----------------------------------------------------
# Cargo.lock       the workspace builds binaries, so the lockfile is committed
# flake.lock       pins the Nix toolchain
# .env.example     the template every developer starts from
