# ==============================================================================
# Local Development Environment (matching Kubernetes k3d ports)
# ==============================================================================

# Database: pgEdge / PostgreSQL (PostgreSQL 17, Thai ICU, UUIDv7, Schema: arch)
DATABASE_URL="postgres://postgres:iX7azt68ErpCKnWobgMbZlaM@localhost:5432/arch?currentSchema=arch"
DATABASE_SCHEMA="arch"
DATABASE_MAX_CONNECTIONS=20
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="iX7azt68ErpCKnWobgMbZlaM"
POSTGRES_DB="arch"
POSTGRES_SCHEMA="arch"

# Cache: Valkey (RESP2/RESP3 Redis-compatible)
VALKEY_URL="redis://localhost:6379"
# Read cache (docs/architecture/11_VALKEY_READ_CACHE.md): false = every read goes to the database
READ_CACHE_ENABLED=true
# Seconds between the per-namespace hit-ratio log lines (0 = never)
CACHE_STATS_SECS=60
# Cache log lines: RUST_LOG="info,api_master=debug,arch::cache=debug" shows every HIT / MISS,
# arch::cache=info only writes / refills / stats, arch::cache=off nothing

# Event Streaming: Redpanda (Kafka Wire Protocol)
KAFKA_BROKERS="localhost:9092"
KAFKA_SCHEMA_REGISTRY="http://localhost:8081"

# Identity / IAM / Auth: Ory Kratos
KRATOS_PUBLIC_URL="http://localhost:4433"
KRATOS_ADMIN_URL="http://localhost:4434"
WEB_KRATOS_URL="/api/kratos"
KRATOS_SECRET_COOKIE="Jfpci5yCsgnuvbVjRIBclqGVfOsqzsG4"
KRATOS_SECRET_CIPHER="aWX3GoibtR2K27AgFdnB9YGV3WHgAbJM"
# Shared secret of the Kratos login-guard web hook (api-master checks it; it must equal `X-Webhook-Secret`
# in kube/arch/applications/arch_identity/base/configmap.yaml). Unset => the hook answers 503 and every login fails.
KRATOS_WEBHOOK_SECRET="login-guard-dev-secret-7c41e9b2"

# Object Storage: Garage (S3 Compatible)
AWS_ENDPOINT_URL="http://localhost:3900"
AWS_REGION="garage"
AWS_ACCESS_KEY_ID="GKa4c1e7b05d3f2a6c91e8b7d2"
AWS_SECRET_ACCESS_KEY="5b1c0e9d7a3f48e2b6d4c8a1f09e7d3b2a5c6e8f1d4b7a9c0e3f6d2b8a5c1e47"
GARAGE_ADMIN_TOKEN="2kfBy0Z0ONiBt6vKE96qaBfTV68OKam3"
GARAGE_RPC_SECRET="8e3d59263a634e6c4b271d60e94e54f28f079904c662bbd5c5c1004a910443bc"
S3_BUCKET_NAME="rust-arch-bucket"

# Audit & Logging: Quickwit (OpenSearch / OTLP search engine)
QUICKWIT_URL="http://localhost:7280"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:7281"

# ==============================================================================
# Backend Services Configuration (api-master, api-report & api-notification)
# ==============================================================================

# Master Service (api-master: Master Data Engine)
MASTER_HOST="0.0.0.0"
MASTER_PORT=8000
MASTER_PREFIX="/api/v1/master"
API_MASTER_PORT=8000
API_MASTER_PREFIX="/api/v1/master"

# Report Service (api-report: Vector PDF & Excel Engine)
REPORT_HOST="0.0.0.0"
REPORT_PORT=8001
REPORT_PREFIX="/api/v1/reports"
API_REPORT_PORT=8001
API_REPORT_PREFIX="/api/v1/reports"
REPORT_API_KEY="report-dev-secret-api-key"

# Notification Service (api-notification: stores notifications and pushes them to web sessions)
NOTIFICATION_HOST="0.0.0.0"
NOTIFICATION_PORT=8002
NOTIFICATION_PREFIX="/api/v1/notifications"
# Redpanda consumer group; with several instances give each its own (each must see every message)
NOTIFICATION_CONSUMER_GROUP="notification-service"
 
# ==============================================================================
# Web dev server (trunk): where /api/* is proxied to. `make web` writes
# handler/web/application/master/Trunk.toml from Trunk.toml.tmpl + these values (all optional).
# Changing WEB_PORT also means: add the new origin to CORS_ALLOWED_ORIGINS below and update the
# Kratos ui_url / allowed_return_urls (kube/arch/applications/arch_identity/base/configmap.yaml).
# ==============================================================================
WEB_PORT=3000
# Defaults to http://localhost:<service port>; set when a service runs elsewhere (another host / container)
# API_MASTER_URL="http://localhost:8000"
# API_REPORT_URL="http://localhost:8001"
# API_NOTIFICATION_URL="http://localhost:8002"

# ==============================================================================
# CORS Configuration (Fully customizable via environment)
# ==============================================================================
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:4433"
CORS_ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD"
CORS_ALLOWED_HEADERS="Authorization,Content-Type,Accept,Cookie,Origin,X-Requested-With,X-Api-Key,X-Session-Token,X-Correlation-Id"
CORS_EXPOSED_HEADERS="Set-Cookie,Location,Content-Disposition,X-Correlation-Id"
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECS=3600

# ==============================================================================
# Audit log (ALPG000): API requests / user actions are indexed in Quickwit
# ==============================================================================
# Quickwit REST endpoint; the index `audit-logs-v1` is created on first use
QUICKWIT_URL="http://localhost:7280"
# false => nothing is recorded and the audit page stays empty
AUDIT_LOG_ENABLED=true
